# Ultra-minimal, secure Bun runtime for Backend Database Server
FROM oven/bun:alpine AS runner

# Create dedicated non-root application user and group (UID 10001)
RUN addgroup -g 10001 -S appgroup && \
    adduser -u 10001 -S appuser -G appgroup

WORKDIR /app

# Create persistent database storage directory
RUN mkdir -p /app/data && chown -R appuser:appgroup /app

# Copy application files
COPY --chown=appuser:appgroup package.json ./
COPY --chown=appuser:appgroup server/ ./server/
COPY --chown=appuser:appgroup scripts/ ./scripts/
COPY --chown=appuser:appgroup src/types.ts ./src/types.ts
COPY --chown=appuser:appgroup src/data/tenants.json ./src/data/tenants.json

# Environment configuration
ENV NODE_ENV=production \
    BUN_ENV=production \
    PORT=3001 \
    HOST=0.0.0.0 \
    DATA_DIR=/app/data

# Switch to non-root user
USER 10001:10001

EXPOSE 3001

HEALTHCHECK --interval=20s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1:3001/healthz || exit 1

CMD ["bun", "server/index.ts"]
