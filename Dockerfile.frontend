# Stage 1: Build static assets
FROM node:22-alpine AS builder

WORKDIR /app

# Enable pnpm via corepack
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy dependency manifests
COPY package.json pnpm-lock.yaml ./

# Install dependencies deterministically
RUN pnpm install --frozen-lockfile

# Copy application source code
COPY . .

# Build production distribution
RUN pnpm run build

# Stage 2: Serve with unprivileged NGINX (Non-root DevSecOps standard)
FROM nginxinc/nginx-unprivileged:alpine-slim AS runner

USER 101

# Copy custom hardened NGINX configuration
COPY --chown=101:101 nginx.conf /etc/nginx/nginx.conf

# Copy production static assets from builder
COPY --from=builder --chown=101:101 /app/dist /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1:8080/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
