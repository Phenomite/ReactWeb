{
  "name": "reactweb",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "build": "pnpm run lint && vite build",
    "check": "biome check --write . && pnpm knip",
    "dev:modify": "bun scripts/dev-modify-db.ts",
    "dev": "vite",
    "format": "biome format --write .",
    "lint:md": "markdownlint-cli2 \"**/*.md\" !node_modules !.agents --fix",
    "lint": "tsc --noEmit && biome lint --write . && pnpm run lint:md",
    "preview": "vite preview",
    "server:dev": "bun --watch server/index.ts",
    "server": "bun server/index.ts",
    "telemetry:cron:once": "bun scripts/k8s-telemetry-generator.ts --once",
    "telemetry:cron": "bun scripts/k8s-telemetry-generator.ts",
    "tenants:generate": "bun scripts/generate-tenants.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "clsx": "~2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "~1.51.0",
    "radix-ui": "^1.6.7",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "tailwind-merge": "~3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.5.15",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "~4.3.3",
    "@types/bun": "~1.4.2",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "~6.1.1",
    "knip": "6.39.0",
    "markdownlint-cli2": "0.23.3",
    "tailwindcss": "~4.3.3",
    "typescript": "~7.0.2",
    "vite": "~8.3.2"
  }
}
